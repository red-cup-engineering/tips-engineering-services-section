{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tips-services-section/tip-receipt",
  "title": "TipReceipt",
  "description": "One verified tip: verify-tip-receipt.mjs's `receipt` field, and book-tip.mjs's input.",
  "type": "object",
  "required": ["rail", "provider", "receiver", "amount", "currency", "receiptId", "verifiedAt"],
  "additionalProperties": false,
  "properties": {
    "rail": { "type": "string", "enum": ["card", "bank", "hive", "base-usdc", "lightning", "platform"] },
    "provider": { "type": "string", "minLength": 1 },
    "receiver": { "type": "string", "minLength": 1 },
    "amount": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$", "description": "Exact decimal string, denominated in currency." },
    "currency": { "type": "string", "minLength": 1 },
    "feeAmount": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$", "description": "A fee already deducted by the provider before the org received the net amount, if any." },
    "receiptId": { "type": "string", "minLength": 1 },
    "verifiedAt": { "type": "string", "format": "date-time" }
  }
}
