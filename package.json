{
  "name": "@red-cup-engineering/tips-services-section",
  "version": "0.2.1",
  "type": "module",
  "description": "Tips through as many endpoints as possible (2026-09-05 ruling, accept-tips-through-every-endpoint): a catalog of tip endpoints across card, hive, base-usdc, lightning, and platform rails, each naming a walletId resolved through key-management-services-section's WalletRegistry rather than a literal receiver (2026-09-05 ruling, payment-receivers-are-parameters-never-literals); verification of a claimed receipt; and booking a verified tip as a balanced Beancount transaction.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/tips-services-section.git"
  },
  "scripts": {
    "check": "for f in src/*.mjs scripts/*.mjs apps/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./src/tips.mjs",
    "./compute-tip-transaction": "./scripts/compute-tip-transaction.mjs",
    "./verify-tip-receipt": "./scripts/verify-tip-receipt.mjs",
    "./book-tip": "./scripts/book-tip.mjs",
    "./derive-tips-page": "./scripts/derive-tips-page.mjs",
    "./tips-cli": "./apps/tips-cli.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "tips-cli": "apps/tips-cli.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/metrologic": "workspace:*",
    "@red-cup-engineering/semiotic-eavt-services-section": "workspace:*",
    "@red-cup-engineering/computer-data-engineering-services-section": "workspace:*",
    "@red-cup-engineering/javascript-node-services-section": "workspace:*",
    "@red-cup-engineering/json-schema-services-section": "workspace:*",
    "@red-cup-engineering/key-management-services-section": "workspace:*",
    "@red-cup-engineering/stripe-services-section": "workspace:*",
    "@red-cup-engineering/witness-journal-document-service": "workspace:*",
    "@red-cup-engineering/x402-services-section": "workspace:*"
  },
  "devDependencies": {
    "@red-cup-engineering/computer-system-engine": "workspace:*"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "sideEffects": false,
  "files": [
    "src",
    "scripts",
    "apps",
    "data/records/schema",
    "data/records/2026-09-05-tip-endpoints.json",
    "data/records/compute-tip-transaction-work-order.md",
    "README.md"
  ],
